rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the user an admin?
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Usuarios: cada uno ve/edita su propio perfil; admin ve todos
    match /usuarios/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre', 'apellido'])
      );
      allow delete: if isAdmin();
    }

    // Citas: usuario ve las suyas; admin ve todas
    match /citas/{citaId} {
      allow read: if isAuth() && (resource.data.usuario_id == request.auth.uid || isAdmin());
      allow create: if isAuth() &&
        request.resource.data.usuario_id == request.auth.uid &&
        request.resource.data.estado == 'pendiente';
      // Cliente puede actualizar solo calificacion/comentario/calificado en sus citas finalizadas
      // Admin puede actualizar cualquier campo (cambio de estado)
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.usuario_id == request.auth.uid &&
          resource.data.estado == "finalizada" &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["calificacion", "comentario", "calificado"])
        )
        || (
          resource.data.usuario_id == request.auth.uid &&
          resource.data.estado in ["pendiente", "confirmada"] &&
          request.resource.data.estado == "cancelada" &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["estado", "cancelada_at"])
        )
      );
      allow delete: if isAdmin();
    }

    // Barberos: lectura pública, escritura solo admin
    match /Barberos/{barberoId} {
      allow read: if true;
      allow write: if isAdmin();

      match /disponibilidad/{fecha} {
        allow read: if isAuth();
        allow create: if isAdmin() || (
          isAuth() &&
          request.resource.data.keys().hasAll(['slots_ocupados']) &&
          request.resource.data.keys().hasOnly(['slots_ocupados'])
        );
        allow update: if isAdmin() || (
          isAuth() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['slots_ocupados'])
        );
        allow delete: if isAdmin();
      }
    }

    // Servicios y Sedes: lectura pública, escritura admin
    match /Servicios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Sedes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Productos tienda: lectura pública
    match /Productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.usuario_id == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.usuario_id == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}
